ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
MASTER_UNLOCK_KEY=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_WEBHOOK_BASE_URL=https://your-public-host.example
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
